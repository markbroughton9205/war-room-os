# War Room environment variables — names only. Copy to .env.local and fill in real values there.
# .env.local is gitignored and must never be committed.

# --- Supabase ---
# NEXT_PUBLIC_* are safe for the browser. SUPABASE_SERVICE_ROLE_KEY is server-only —
# never expose it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Must exactly match the Supabase Storage bucket name (including spaces/capitalization).
SUPABASE_FILES_BUCKET=

# --- LLM providers (Council) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Foundry PASS 005 model routing. Example: cursor-agent:gpt-5.6-sol-medium.
# Provider ids: cursor-agent:<model-id>, ollama, anthropic, openai, gemini, xai,
# or a configured OpenAI-compatible endpoint. Values are server-only.
FOUNDRY_PRIMARY_MODEL=cursor-agent:gpt-5.6-sol-medium
FOUNDRY_FALLBACK_MODEL=
FOUNDRY_OPENAI_COMPATIBLE_PROVIDER=
FOUNDRY_OPENAI_COMPATIBLE_BASE_URL=
FOUNDRY_OPENAI_COMPATIBLE_MODEL=
FOUNDRY_OPENAI_COMPATIBLE_API_KEY=
# Kimi / Moonshot is NOT INSTALLED, NOT CONFIGURED, and NOT A WAR ROOM CAPABILITY.
# NOVA is local Ollama. Do not set KIMI_API_KEY or MOONSHOT_API_KEY.
# Local inference endpoint for Council GENERAL (huihui_ai/qwen3-abliterated:14b).
# Server-only. Never prefix NEXT_PUBLIC_. Defaults to http://127.0.0.1:11434 if unset.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HOST=127.0.0.1:11434

# Minimal Stable Council Mode — isolates provider calls from shared orchestration middleware.
# Set to true during emergency stability sprints; false for full council features.
COUNCIL_STABILITY_MODE=false
# direct | stable_group | full_council
COUNCIL_MODE=

# GI-ENG-01 PathClassifier / SHORT_PATH front door. Default OFF.
# Do not enable in production without explicit Commander order: ENABLE GI-ENG-01 SHORT_PATH
GI_ENG_01_SHORT_PATH=0
# GI-ENG-02 test-only live model invoke for short-path completion. Default OFF.
# Does not enable production SHORT_PATH. Production enablement requires a separate Commander order.
GI_ENG_02_SHORT_PATH_COMPLETE=0
# GI-ENG-03 live acceptance uses an isolated in-process flag. Do not set production SHORT_PATH.

# --- Search / research ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
BRAVE_API_KEY=
# Official Google Web Search Service (server-only). GET https://websearchservice.googleapis.com/v1:search
# Do not use the retired Site Restricted Custom Search API. If unset, Search continues without Google.
GOOGLE_WEB_SEARCH_API_KEY=
GOOGLE_WEB_SEARCH_CLIENT_ID=

# Official YouTube Data API v3 for Terra verified channel ingest (server-only).
# Never prefix NEXT_PUBLIC_. Never send this key to the browser. Do not use search.list.
YOUTUBE_API_KEY=

# Self-hosted SearXNG federation (server-only). Additive discovery provider — not a crawler/index.
# JSON search: GET {SEARXNG_BASE_URL}/search?q=...&format=json
# If unset, Search/Council continue without SearXNG. HTTP is allowed only for trusted LAN/internal hosts.
# SearXNG has no native API key; optional header auth is for a reverse proxy in front of the instance.
SEARXNG_BASE_URL=
SEARXNG_AUTH_HEADER=
SEARXNG_AUTH_VALUE=
SEARXNG_TIMEOUT_MS=

# Stage 3 sovereign crawler / local index (server-only). Additive retrieval, not a publisher.
# Documents + SQLite live under .war-room/sovereign-search/ unless overridden.
# Crawls require an explicit Commander/trusted-internal approval in code; no autonomous spider.
WAR_ROOM_SOVEREIGN_SEARCH_DIR=
WAR_ROOM_CRAWL_ALLOWLIST=
WAR_ROOM_CRAWL_DENYLIST=
WAR_ROOM_CRAWL_DISABLED=
WAR_ROOM_LOCAL_SEARCH_DISABLED=

# --- Signals / RSS ---
RSS_POLL_INTERVAL_MINUTES=
SIGNAL_SOURCE_URLS=
SIGNAL_NEWS_MAX_AGE_DAYS=
# Optional per-provider freshness overrides (each has two accepted spellings):
GUARDIAN_SIGNAL_MAX_AGE_DAYS=
SIGNAL_GUARDIAN_MAX_AGE_DAYS=
NEWSAPI_SIGNAL_MAX_AGE_DAYS=
SIGNAL_NEWSAPI_MAX_AGE_DAYS=
RSS_SIGNAL_MAX_AGE_DAYS=
SIGNAL_RSS_MAX_AGE_DAYS=
TAVILY_SIGNAL_MAX_AGE_DAYS=
SIGNAL_TAVILY_MAX_AGE_DAYS=
WAR_ROOM_RSS_POLL_SECRET=


# Opportunity discovery — server-side only
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SAM_GOV_API_KEY=

# --- Payments ---
# Financial actions require secure War Room approval; never store raw routing/account numbers.
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
SQUARE_ACCESS_TOKEN=

# --- NASA GIBS Earth Intelligence (/earth-intelligence) ---
# Public WMTS endpoint — takes no API key. Kept server-side for the
# /api/earth-intelligence/health check; the browser uses a reviewed public
# constant (lib/earth-intelligence/gibsTileUrl.ts), not this env var directly.
# GIBS is unauthenticated, so no API key variable exists for it in this phase.
NASA_GIBS_WMTS_BASE_URL=
# Optional public Cesium ion access token. Enables Cesium World Terrain in /terra; leave blank
# to retain the credential-free ellipsoid + OSM fallback. Never commit a real token.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Optional Mapillary client token for Terra STREET VIEW / Street Intelligence hosted imagery.
# Architecture works without it (PROVIDER_AUTH_REQUIRED). Never commit a real token.
# Do not use this for Google Street View.
NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=

# Optional Panoramax instance (self-host or regional). STREET VIEW uses the public
# https://api.panoramax.xyz instance when this is unset. LOCAL/REGIONAL coverage only —
# not global Street View. Never scrape Google.
# Example: https://api.panoramax.xyz
NEXT_PUBLIC_PANORAMAX_INSTANCE_URL=

# --- Research Engine (read-only, server-only — /api/research/*) ---
# See docs/RESEARCH_ENGINE_ARCHITECTURE.md, RESEARCH_PROVIDER_MATRIX.md,
# RESEARCH_ENGINE_SECURITY.md and RESEARCH_ENGINE_RUNBOOK.md.
# Every provider is optional: an absent key marks that provider "unavailable"
# in the registry, it never fails the app. Names only below — fill real
# values in .env.local, never here.
GITHUB_TOKEN=
EXA_API_KEY=
FMCSA_WEB_KEY=
SAM_GOV_API_KEY=
NCBI_API_KEY=
FRED_API_KEY=
ARXIV_API_BASE_URL=
CROSSREF_API_BASE_URL=
CROSSREF_MAILTO=
CROSSREF_USER_AGENT_BASE=
SEMANTIC_SCHOLAR_API_KEY=
NASA_API_KEY=
USPTO_API_KEY=
COURTLISTENER_API_TOKEN=
INTERNET_ARCHIVE_BASE_URL=
WAYBACK_BASE_URL=
INTERNET_ARCHIVE_USER_AGENT_BASE=
WORLD_BANK_API_BASE_URL=
WORLD_BANK_WDI_SOURCE_ID=
WORLD_BANK_DATA_CATALOG_API_BASE_URL=
WORLD_BANK_PROJECTS_API_BASE_URL=
WORLD_BANK_FINANCES_API_BASE_URL=
WORLD_BANK_CLIMATE_API_BASE_URL=
IMF_SDMX_3_API_BASE_URL=
IMF_SDMX_21_API_BASE_URL=
IMF_API_SUBSCRIPTION_KEY=
USGS_WATER_API_BASE_URL=
USGS_WATER_API_KEY=
# NASA FIRMS MAP_KEY for active fire / thermal-anomaly detections (server-only).
# Unset = AUTH_REQUIRED. Never prefix NEXT_PUBLIC_. Detections are not automatically wildfires.
NASA_FIRMS_MAP_KEY=
USGS_NATIONAL_MAP_API_BASE_URL=
USGS_SCIENCEBASE_API_BASE_URL=
LIBRARY_OF_CONGRESS_API_BASE_URL=
WIKIDATA_ACTION_API_URL=
WIKIDATA_ENTITY_DATA_BASE_URL=
WIKIDATA_SPARQL_ENDPOINT=
WIKIDATA_SCHOLARLY_SPARQL_ENDPOINT=
WIKIMEDIA_USER_AGENT_BASE=
COMMON_CRAWL_INDEX_BASE_URL=
COMMON_CRAWL_DATA_BASE_URL=
COMMON_CRAWL_COLLECTIONS_URL=
COMMON_CRAWL_USER_AGENT_BASE=
# Required. A specific, currently-existing Common Crawl collection id (e.g.
# CC-MAIN-2025-33) — this build does not auto-discover the "current" crawl
# because doing so would require a live fetch of the operational
# collinfo.json catalog, which this build's controls do not permit. An
# unknown/stale id documented-returns HTTP 404 from the index endpoint, not
# an empty result, so an incorrect value surfaces as an honest upstream error.
COMMON_CRAWL_COLLECTION_ID=

# --- Deploy / Vercel ---
NEXT_PUBLIC_APP_URL=
# Production URL candidate for deploy-status probes (checked before VERCEL_URL/DEPLOY_PRIME_URL).
NEXT_PUBLIC_SITE_URL=
VERCEL_ACCESS_TOKEN=
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=
VERCEL_API_TOKEN=

# --- Environment / intelligence feeds ---
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
MARKET_WATCHLIST=
FINANCE_SYMBOLS=

# --- Internal secrets / debug gates ---
WAR_ROOM_AUDIT_POST_SECRET=
WAR_ROOM_DEBUG_SECRET=
# Checked by assertActionRouteAuthorized on /api/grok/chat, /api/payments/deposits,
# and /api/payments/proof. Accepts either a timing-safe match of this secret
# (server-to-server callers) OR a signed-in Supabase session (Commander via the
# browser UI) — see lib/security/actionRouteGuard.ts. Other action-triggering
# routes (e.g. /api/permissions/update) aren't gated by this
# secret; they're covered by the session check in middleware.ts instead.
WAR_ROOM_ACTION_SECRET=
WAR_ROOM_SIGNUP_INVITATION_SECRET=
DEBUG_INTEGRITY=

# --- Feature flags ---
WAR_ROOM_TOOLS_MOCK=
WAR_ROOM_MEMORY_PROPOSALS_ENABLED=
WAR_ROOM_ACTION_QUEUE_SESSION_ONLY_FALLBACK=
WAR_ROOM_INTERNET_UNWIRED=

# --- Terra maritime providers (server-only; never expose values to the browser) ---
# BarentsWatch Open AIS (Norway) — OAuth2 client credentials from developer.barentswatch.no
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
# AISStream.io WebSocket key (server-side only; browser connections are forbidden)
AISSTREAM_API_KEY=
# AISHub contributor username (issued only after contributing a real AIS feed)
AISHUB_USERNAME=
# Optional shared token for POST /api/terra/own-sensor/ais (loopback is allowed without it)
TERRA_AIS_CATCHER_INGEST_TOKEN=

# --- Terra traffic cameras (server-only; never expose values to the browser) ---
# OHGO public API (Ohio DOT). Register at https://publicapi.ohgo.com/accounts/registration
OHGO_API_KEY=
# Identifying User-Agent for public Earth data (MET Norway / Nominatim require product+contact).
TERRA_USER_AGENT_BASE=
# Optional Terra search fallback when Nominatim is rate-limited (429). Default: open_meteo (no key).
# Set to none to disable. geonames requires GEONAMES_USERNAME.
TERRA_FALLBACK_GEOCODER=open_meteo
GEONAMES_USERNAME=
# Regional precision plugins (default on). Set to 0/off to disable a county/statewide adapter.
# These never run worldwide — coverage router decides eligibility.
TERRA_SUMMIT_ADDRESS_POINTS=1
TERRA_OHIO_LBRS=1
# 511NY Iteris developer key — omit until issued. Adapter stays not_configured without it.
# 511NY_API_KEY=

# --- Misc ---
# Absolute path to this repo, used by local tooling that shells out to it.
REPO_ROOT=
# Isolated Foundry Application Builder projects. Default is ~/FoundryProjects.
# Never set this to the War Room source tree.
FOUNDRY_PROJECTS_ROOT=
# HVS creative intelligence (server-only). Names only — never put real keys here.
# Reuses the existing Council provider keys unless an explicit HVS vendor is set.
HVS_CREATIVE_PROVIDER=
HVS_CREATIVE_MODEL=
# Set to 0 to force deterministic/fallback creative mode.
HVS_CREATIVE_LIVE=
# Visual frame upload to an external provider. Default off. Requires existing external-upload policy.
HVS_CREATIVE_VISION_AUTHORIZED=
# Foundry Workbench W0–W6 guest pane. Default off. Governed extensions stay behind this flag.
FOUNDRY_WORKBENCH_W0=0
# Proof-only deterministic Foundry assist. Do not use as production model routing.
# FOUNDRY_WORKBENCH_W2_DETERMINISTIC=0
