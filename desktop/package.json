{
  "name": "war-room-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Sovereign AI Operations Headquarters",
  "author": "War Room OS",
  "homepage": "https://warroomos.com",
  "desktopName": "war-room-os",
  "main": "src/main.cjs",
  "productName": "War Room OS",
  "scripts": {
    "start": "electron .",
    "build:check": "node scripts/build-check.cjs",
    "icon:ico": "node scripts/generate-icon-ico.cjs",
    "icon:linux": "node scripts/generate-linux-icons.cjs",
    "prepare:runtime": "node ../scripts/prepare-desktop-runtime.mjs",
    "dist": "npm run icon:ico && node scripts/build-installer.cjs",
    "dist:dir": "electron-builder --win dir --x64",
    "dist:linux": "npm run icon:linux && electron-builder --linux AppImage deb --x64"
  },
  "build": {
    "appId": "com.warroomos.desktop",
    "productName": "War Room OS",
    "copyright": "Copyright © War Room OS",
    "directories": {
      "output": "dist-release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "workbench-host/**/*",
      "package.json",
      "assets/war-room-os.ico",
      "assets/war-room-os-icon.png",
      "assets/war-room-os.png",
      "assets/ICON_PROVENANCE.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": ["**/*"]
      },
      {
        "from": "assets/war-room-os.ico",
        "to": "assets/war-room-os.ico"
      },
      {
        "from": "assets/war-room-os-icon.png",
        "to": "assets/war-room-os-icon.png"
      },
      {
        "from": "assets/war-room-os.png",
        "to": "assets/war-room-os.png"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/war-room-os.ico",
      "artifactName": "War Room OS Setup.${ext}",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "War Room OS",
      "installerIcon": "assets/war-room-os.ico",
      "uninstallerIcon": "assets/war-room-os.ico",
      "installerHeaderIcon": "assets/war-room-os.ico",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "War Room OS",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/linux-icons",
      "category": "Utility",
      "executableName": "war-room-os",
      "syncDesktopName": true,
      "maintainer": "War Room OS <noreply@warroomos.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "synopsis": "Sovereign AI Operations Headquarters",
      "desktop": {
        "entry": {
          "Name": "War Room OS",
          "Comment": "Sovereign AI Operations Headquarters",
          "StartupWMClass": "War Room OS"
        }
      }
    },
    "afterPack": "./scripts/after-pack-linux-sandbox.cjs",
    "publish": null
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  }
}
